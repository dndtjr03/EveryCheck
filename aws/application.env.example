# =============================================================================
# EveryCheck — AWS(S3 + RDS)에서 AI 워커·API가 동작할 때 사용하는 환경 변수 예시
# =============================================================================
# 사용법: 이 파일을 복사한 뒤 실제 값으로 채우고, 컨테이너/프로세스에 env_file 또는
#        Secrets Manager/Parameter Store 주입으로 로드한다. (예: cp application.env.example .env)
#
# Celery 워커(`analyze_image_task`) 동작에 필요한 최소 연결:
#   - RDS: DATABASE_URL → SQLAlchemy가 RepairEstimate 등에 분석 결과 저장
#   - S3:  DamageImage.s3_url 형식과 동일한 버킷에서 GetObject (boto3)
#   - Redis: CELERY_BROKER_URL (태스크 큐)
#   - Gemini: GOOGLE_API_KEY (모델 호출)
#
# 자격 증명:
#   - EC2/ECS/EKS에서는 Task/Instance Role만 쓰고 아래 ACCESS_KEY 둘은 비워 둔다.
#   - 로컬·CI에서 실제 AWS에 붙을 때만 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY 사용.
# =============================================================================

# ----- RDS (PostgreSQL) -----
# 형식: postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME[?sslmode=require]
# RDS는 TLS 권장. 엔드포인트는 RDS 콘솔의 "엔드포인트" 호스트명을 사용한다.
DATABASE_URL=postgresql+psycopg2://app:CHANGE_ME@your-db.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com:5432/teogeo?sslmode=require

# 연결 풀(선택, database.py 기본값과 동일하면 생략 가능)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=3600

# ----- AWS S3 (업로드 URL과 워커 다운로드가 같은 버킷·리전을 가리켜야 함) -----
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your-everycheck-damage-images

# IAM 사용자·로컬 개발용(역할 사용 시 미설정)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# (세션 토큰 임시 자격 증명이면) AWS_SESSION_TOKEN=

# ----- Celery / Redis (ElastiCache 또는 자체 Redis) -----
CELERY_BROKER_URL=redis://your-redis.xxxxxx.ng.0001.apn2.cache.amazonaws.com:6379/0
CELERY_RESULT_BACKEND=redis://your-redis.xxxxxx.ng.0001.apn2.cache.amazonaws.com:6379/0

# ----- Google Gemini (worker.py) -----
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# ----- API 서버·워커 공통으로 자주 필요한 항목(docker-compose 연동 시) -----
# JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# IAM 권한 요약 (워커 역할에 연결할 정책 예시 — JSON은 IAM 콘솔에 붙여 넣어 조정)
# =============================================================================
# S3: 저장된 객체 키에 대해 s3:GetObject (버킷 ARN: arn:aws:s3:::your-bucket/*)
#     업로드 API까지 동일 역할이면 s3:PutObject 추가
# RDS: 보안 그룹으로 VPC 내에서 5432만 허용하는 것이 일반적( IAM DB 인증은 별도 설정)
# =============================================================================
