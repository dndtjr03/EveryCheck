# =============================================================================
# 다봐드림(teogeo) — 배포용 환경 변수 예시
# 이 파일을 복사해 .env 를 만든 뒤 값을 채우세요. (.env 는 Git 에 올리지 않습니다.)
# =============================================================================

# --- 필수: JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- 필수: PostgreSQL (Docker Compose 의 db 서비스와 동일해야 함) ---
DB_USER=app
DB_PASSWORD=app
DB_NAME=teogeo
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/teogeo

# 로컬에서 앱만 실행할 때 예시:
# DATABASE_URL=postgresql+psycopg2://app:app@localhost:5432/teogeo

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- AWS S3 (이미지 업로드) ---
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=

# --- Google Gemini (Celery AI 분석) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- CORS / HTTPS 응답 헤더 ---
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
ENABLE_HSTS=0

# --- DB 연결 풀 (선택) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# --- 보안 감사 로그 (웹 컨테이너 볼륨 security_logs 에 기록) ---
SECURITY_LOG_PATH=/var/log/teogeo/security_audit.log
SECURITY_LOG_MAX_BYTES=10485760
SECURITY_LOG_BACKUP_COUNT=5

# --- Docker Compose 포트 (호스트) ---
WEB_HOST_PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# 공통 환경 변수 템플릿 (.env 예시 파일)
# 이 파일을 복사하여 .env 로 이름을 변경한 뒤
# 실제 값(특히 비밀번호, 시크릿 키, 버킷 이름 등)을 채워서 사용하세요.
# ⚠️ 실제 비밀번호/시크릿이 채워진 .env 파일은 절대 Git 저장소(GitHub 등)에 올리지 마세요.

############################
# 데이터베이스 설정 (PostgreSQL)
############################

# DB 호스트 (docker-compose 사용 시 기본값은 db 서비스 이름)
DB_HOST=db

# DB 포트
DB_PORT=5432

# DB 사용자 이름 (docker-compose의 POSTGRES_USER와 동일)
DB_USER=app

# DB 비밀번호 (직접 설정 필요)
DB_PASSWORD=

# DB 이름 (docker-compose의 POSTGRES_DB와 동일)
DB_NAME=teogeo

# SQLAlchemy에서 사용하는 전체 접속 URL
# 위 DB_* 값을 조합한 형태 예시:
# postgresql+psycopg2://app:비밀번호@db:5432/teogeo
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/teogeo

############################
# JWT / 인증 설정
############################

# JWT 서명용 비밀 키 (반드시 강력한 랜덤 문자열 사용)
JWT_SECRET_KEY=

# (호환) 일부 환경에서는 JWT_SECRET 이름을 사용할 수 있습니다.
# 가능하면 JWT_SECRET_KEY만 사용하고, 필요 시 아래 값을 동일하게 맞춰주세요.
JWT_SECRET=

# JWT 알고리즘 (기본값: HS256)
JWT_ALGORITHM=HS256

# 액세스 토큰 만료 시간(분 단위)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 리프레시 토큰 만료 기간(일 단위)
REFRESH_TOKEN_EXPIRE_DAYS=14

############################
# CORS 설정 (프론트 연동)
############################

# 허용할 Origin 목록 (콤마로 구분)
# 예: http://localhost:3000,https://dev.example.com
# 전체 허용은 "*" (개발용 권장, 운영에서는 최소 범위로 제한)
CORS_ALLOW_ORIGINS=*

############################
# AWS S3 설정
############################

# S3 리전 (예: ap-northeast-2)
AWS_REGION=ap-northeast-2

# 이미지 업로드 대상 S3 버킷 이름 (실제 사용하는 버킷명으로 변경)
S3_BUCKET_NAME=

