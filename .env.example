# =============================================================================
# 다봐드림(teogeo) — 배포용 환경 변수 예시
# 이 파일을 복사해 .env 를 만든 뒤 값을 채우세요. (.env 는 Git 에 올리지 않습니다.)
# =============================================================================

# --- 필수: JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- 필수: PostgreSQL (Docker Compose 의 db 서비스와 동일해야 함) ---
DB_USER=app
DB_PASSWORD=app
DB_NAME=teogeo
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/teogeo

# 로컬에서 앱만 실행할 때 예시:
# DATABASE_URL=postgresql+psycopg2://app:app@localhost:5432/teogeo

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- AWS S3 (이미지 업로드) ---
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=

# --- Google Gemini (Celery AI 분석) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- CORS / HTTPS 응답 헤더 ---
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
ENABLE_HSTS=0

# --- DB 연결 풀 (선택) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# --- 보안 감사 로그 (웹 컨테이너 볼륨 security_logs 에 기록) ---
SECURITY_LOG_PATH=/var/log/teogeo/security_audit.log
SECURITY_LOG_MAX_BYTES=10485760
SECURITY_LOG_BACKUP_COUNT=5

# --- Docker Compose 포트 (호스트) ---
WEB_HOST_PORT=8000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
